{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kin-family-messenger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ConversationRoom" },
      { "name": "PAIRS", "class_name": "PairingSession" },
      { "name": "INVITES", "class_name": "InviteTicket" },
      { "name": "LINKS", "class_name": "DeviceLink" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["PairingSession"] },
    { "tag": "v2", "new_classes": ["ConversationRoom"] },
    { "tag": "v3", "new_classes": ["InviteTicket"] },
    { "tag": "v4", "new_classes": ["DeviceLink"] }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "kin-attachments" }
  ],
  "routes": [
    { "pattern": "kin.c0di.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
