{
  "name": "kin-family-messenger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/materialize-icons.mjs",
    "dev": "vite",
    "dev:relay": "wrangler dev",
    "prebuild": "node scripts/materialize-icons.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "icons": "tauri icon assets/app-icon.svg",
    "pretauri": "npm run icons",
    "tauri": "tauri",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.124.0"
  }
}
